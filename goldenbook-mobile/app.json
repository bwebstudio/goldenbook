{
  "expo": {
    "name": "Goldenbook Go",
    "slug": "goldenbook",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#161E38"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bwebstudio.goldenbook",
      "buildNumber": "78",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used to show nearby places and local recommendations.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-android.png",
        "backgroundColor": "#161E38"
      },
      "package": "com.bwebstudio.goldenbook",
      "versionCode": 83,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-asset",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Your location is used to show nearby places and local recommendations.",
          "locationWhenInUsePermission": "Your location is used to show nearby places and local recommendations.",
          "locationAlwaysPermission": "Your location is used to show nearby places and local recommendations."
        }
      ],
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#161E38"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "enableProguardInReleaseBuilds": false,
            "useLegacyPackaging": false
          }
        }
      ],
      "./plugins/withAndroid16KBPages.js",
      "./plugins/withImageDeps16KB.js",
      "./plugins/withFmtNoConsteval.js",
      [
        "expo-notifications",
        {
          "color": "#D2B68A"
        }
      ]
    ],
    "scheme": "goldenbook",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "134f9bf5-71ef-42f0-bef9-789e42476be1"
      }
    },
    "owner": "goldenbook",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/134f9bf5-71ef-42f0-bef9-789e42476be1"
    },
    "locales": {
      "en": "./native-locales/en.json",
      "es": "./native-locales/es.json",
      "pt": "./native-locales/pt.json"
    }
  }
}
